    <string name="privacy_listener_title">How Notification Access Works</string>
    <string name="privacy_listener_desc">Android\'s NotificationListenerService allows the app to inspect posted status bar alerts. Pausing collection inside the app stops saving alerts, but the Android system permission remains active until toggled in Android Settings.</string>
    <string name="privacy_sensitive_title">Private &amp; Sensitive Notification Content</string>
    <string name="privacy_sensitive_desc">Notifications frequently contain private communications, personal details, or verification codes. Notification Tracker does not claim to magically detect or redact sensitive content; we recommend excluding sensitive banking or messaging apps using Excluded Apps.</string>
